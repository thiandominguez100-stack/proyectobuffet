rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Cada usuario autenticado puede consultar únicamente su propio rol.
    // Los roles se asignan manualmente desde Firebase Console; nunca desde el cliente.
    match /staffRoles/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    // Todo lo demás permanece cerrado hasta implementar y probar
    // reglas específicas para alumnos, pedidos y administración.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}