rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Cierre seguro inicial.
    // No habilitar lecturas ni escrituras hasta que se incorporen y prueben
    // las reglas específicas para alumnos, personal y administradores.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
